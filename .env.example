# Optional local overrides for `shellui.config.json` (defaults keep local Vite URLs).
# Copy to `.env`. The Shellui CLI loads dotenv when you run `pnpm start`.
# Production builds load `.env.prod` instead (see package.json `build` script).
# Local iframe app: `pnpm start:app` (Vite, default http://localhost:5173).

# PLAYGROUND_APP_URL=http://localhost:5173
# WEBSITE_URL=http://localhost:8080/
# DOCS_URL=https://docs.shellui.com

# Backend. Leave the company and the admin app unset until you choose them.
# An empty SHELLUI_ADMIN_URL keeps the config placeholder http://admin.invalid.
# SHELLUI_IDENTITY_URL=https://id.eu.shellui.com
# SHELLUI_ADMIN_URL=
# SHELLUI_COMPANY_ID=

# Files app. Leave unset until you choose an app that may receive the access token.
# FILES_URL=
