# Optional local overrides for `shellui.config.json` (defaults keep local Vite URLs).
# Copy to `.env` — the Shellui CLI loads dotenv when you run `pnpm start`.
# Production builds load `.env.prod` instead (see package.json `build` script).

# PLAYGROUND_APP_URL=http://localhost:5173
# WEBSITE_URL=http://localhost:8080/
# DOCS_URL=https://docs.shellui.com
# FILES_URL=https://files.shellui.com

# Backend (optional)
# SHELLUI_BACKEND_URL=https://id.shellui.com
# SHELLUI_ADMIN_URL=https://admin.shellui.com
# SHELLUI_COMPANY_ID=1
