{
  "name": "shellui-playground",
  "version": "0.5.2",
  "description": "A live demo of Shellui, deployed to GitHub Pages",
  "type": "module",
  "scripts": {
    "start": "node tools/shellui/accept-marketplace-config.mjs && shellui start",
    "start:app": "vite",
    "start:desktop": "node tools/desktop/configure-sign-in.mjs && node tools/shellui/accept-marketplace-config.mjs && shellui start --app",
    "build": "pnpm legal:check && node tools/shellui/accept-marketplace-config.mjs && DOTENV_CONFIG_PATH=.env.prod shellui build && vite build",
    "build:desktop": "node tools/desktop/configure-sign-in.mjs && node tools/shellui/accept-marketplace-config.mjs && DOTENV_CONFIG_PATH=.env.prod shellui build --app",
    "build:sdk": "pnpm --dir ../shellui run build:sdk",
    "preview": "vite preview",
    "serve:dist": "node tools/serve/serve.js",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "test": "node --test tools/config/starter-trust.test.mjs",
    "prepare": "husky",
    "legal:sync": "node tools/legal/sync-legal.mjs",
    "legal:check": "node tools/legal/sync-legal.mjs --check"
  },
  "lint-staged": {
    "*": "pnpm exec prettier --write --ignore-unknown"
  },
  "author": "Shellui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shellui/playground.git"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  },
  "dependencies": {
    "@shellui/cli": "0.8.6",
    "@shellui/core": "0.8.6",
    "@shellui/sdk": "0.8.6",
    "i18next": "^27.2.9",
    "lucide-react": "^0.468.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-react": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "vite": "^6.4.6"
  }
}
