{
  "name": "shellui-playground",
  "version": "0.3.0",
  "description": "A playground for Shellui — demo deployed to GitHub Pages",
  "type": "module",
  "scripts": {
    "start": "shellui start",
    "start:app": "vite",
    "build": "DOTENV_CONFIG_PATH=.env.prod shellui build && vite build",
    "preview": "vite preview",
    "serve:dist": "node tools/serve/serve.js",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "pnpm exec prettier --write --ignore-unknown"
  },
  "author": "Shellui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shellui/playground.git"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@shellui/cli": "0.5.0-beta.1",
    "@shellui/core": "0.5.0-beta.1",
    "@shellui/sdk": "0.5.0-beta.1",
    "i18next": "^24.2.0",
    "lucide-react": "^0.468.0",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^7.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "vite": "^6.0.3"
  }
}
