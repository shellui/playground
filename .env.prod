# Production overrides loaded by `pnpm build` (DOTENV_CONFIG_PATH=.env.prod).
# Resolved into shellui.config.json at build time — not available at runtime in the browser.

# Embedded playground app (Vite base `/app/` in production)
PLAYGROUND_APP_URL=/app

# External links
WEBSITE_URL=https://shellui.com/
DOCS_URL=https://docs.shellui.com
FILES_URL=https://files.shellui.com
